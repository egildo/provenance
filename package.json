{
  "name": "@egildo/provenance",
  "version": "0.6.2",
  "description": "Knows, for one rendered document, every source involved, how the sources depend on each other, and where each came from.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://codeberg.org/egildo/provenance.git"
  },
  "homepage": "https://codeberg.org/egildo/provenance",
  "bugs": "https://codeberg.org/egildo/provenance/issues",
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./css": {
      "types": "./dist/css.d.ts",
      "import": "./dist/css.js"
    },
    "./html": {
      "types": "./dist/html.d.ts",
      "import": "./dist/html.js"
    },
    "./memory": {
      "types": "./dist/memory.d.ts",
      "import": "./dist/memory.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "tsc && node --test",
    "prepublishOnly": "npm test && npm run build"
  },
  "dependencies": {
    "parse5": "^8.0.1",
    "postcss": "^8.5.28",
    "postcss-safe-parser": "^7.1.0",
    "postcss-value-parser": "^4.2.0"
  },
  "devDependencies": {
    "@egildo/cascata": "^1.16.2",
    "@types/node": "^22",
    "typescript": "^5.9"
  }
}
